# Database Configuration
DATABASE_URL=sqlite:///./app.db

# JWT Configuration (generate a secure random string for production)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (used for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id

# Supabase Storage for image uploads (leave empty to disable uploads;
# the editor then falls back to pasting image URLs). Project URL + service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
UPLOAD_BUCKET=lekhani-media

# Public URL of the Lekhani frontend (used for sitemap/RSS links)
FRONTEND_URL=https://lekhanii.vercel.app

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Environment
ENVIRONMENT=development
