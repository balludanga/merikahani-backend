# Lekhani backend — local development template.
#   cp .env.example .env
# Production values live in the Render dashboard / render.yaml, never in this file.

# Environment. Debug mode serves /docs, trusts the localhost dev origins and keeps
# IndexNow from pinging real search engines. It fails closed: unset means production, and
# with production settings the app refuses to start until SECRET_KEY is a real random value.
DEBUG=true

# Database — SQLite is fine locally; production is a PostgreSQL (Supabase) URL.
DATABASE_URL=sqlite:///./app.db

# JWT signing key — a private random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here

# Google sign-in (OAuth client id; the secret stays in the Google console)
GOOGLE_CLIENT_ID=your_google_client_id

# Supabase Storage for image uploads (leave empty to disable uploads;
# the editor then falls back to pasting image URLs). Project URL + service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
UPLOAD_BUCKET=lekhani-media

# Public URL of the Lekhani frontend (used for sitemap/RSS links, shares and IndexNow pings)
FRONTEND_URL=https://lekhanii.vercel.app

# IndexNow (Bing, Yandex, …). Leave enabled unset to follow DEBUG: off locally, on in
# production. The key is public by design — the frontend must serve it at /<key>.txt.
# INDEXNOW_KEY=4740513ae79e931a49c79fb66dd01fee
# INDEXNOW_ENABLED=

# Server-side narration of stories in a Hindi voice (Google AI Studio, free key, no card).
# Without a key the listen button falls back to the reader's own browser voice. Only
# published stories are ever sent. Every model/voice knob below is optional.
# GEMINI_API_KEY=
# TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# TTS_FEMALE_VOICES=hi-in-storyteller-2,hi-in-storyteller-6,hi-in-podcaster-9,hi-in-assistant-12
# TTS_MALE_VOICES=hi-in-storyteller-1,hi-in-assistant-1
# CAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# TTS_CHUNK_CHARS=1500
# TTS_WINDOW_CHARS=3000
# TTS_MONTHLY_CHARS=300000
# TTS_MAX_STORY_CHARS=12000

# Who may open the owner's status page (/api/ops), review stories, decide write-and-earn
# applications and handle the monthly pool and payouts: comma-separated emails. Only accounts
# whose address Google verified count; empty means nobody. Keep the real list out of git.
# ADMIN_EMAILS=

# The owner: the only account that sees the money pages (the monthly sheet that suggests the pool,
# the books, the payment log). Same rules as ADMIN_EMAILS (Google-verified address, comma-separated,
# empty means nobody). An owner is also a reviewer, so they need not be listed in both. A reviewer who
# is not listed here gets a plain 404 on those pages.
# OWNER_EMAILS=

# Write and earn (the partner programme). A writer may apply once they have this many
# followers and published stories; the review team then decides. After a decline they wait
# PARTNER_REAPPLY_DAYS. Only readers whose account is at least PARTNER_READER_MIN_AGE_DAYS old
# count towards a month's pool. Amounts under PARTNER_MIN_PAYOUT_RUPEES are carried over. All
# optional: the values below are the defaults.
# PARTNER_MIN_FOLLOWERS=200
# PARTNER_MIN_STORIES=1
# PARTNER_REAPPLY_DAYS=30
# PARTNER_READER_MIN_AGE_DAYS=7
# PARTNER_MIN_PAYOUT_RUPEES=100

# Payments (tips to partner writers, memberships). EMPTY = the site takes no money and shows nothing
# about it, which is how it ships. PAYMENTS_PROVIDER names the connected provider; "sandbox" is an offline
# stand-in for development only (the server refuses to start with it unless DEBUG=true). No real provider
# is connected yet: app/core/payments/providers/razorpay.py is a skeleton listing the steps. The three
# credentials are provider-neutral; whichever adapter is connected reads them.
# PAYMENTS_PROVIDER=
# PAYMENTS_API_KEY=
# PAYMENTS_API_SECRET=
# PAYMENTS_WEBHOOK_SECRET=
# Tips: smallest and largest tip and the quick-pick amounts (rupees); the site's cut in basis points
# (1000 = 10%, and the public Help/Terms text says 10%: change them together). Memberships: prices in
# rupees with tax included; GST_PERCENT is the GST inside them (0 while not registered).
# TIP_MIN_RUPEES=10
# TIP_MAX_RUPEES=10000
# TIP_PRESET_RUPEES=20,50,100
# TIP_SITE_FEE_BPS=1000
# MEMBERSHIP_MONTHLY_RUPEES=49
# MEMBERSHIP_YEARLY_RUPEES=399
# GST_PERCENT=0
# What a reader's reaction is worth towards a writer's monthly points, by whether the reader held a
# membership at that moment (whole numbers, 1-10 for members and 0-10 for everyone else; each month can
# override both in the reviewers' desk). 1 and 1 changes nothing; 1 and 0 counts members only.
# POINTS_MEMBER_WEIGHT=1
# POINTS_NONMEMBER_WEIGHT=1

# Where narration MP3s are kept: db (in the database, as before; the default), local (a folder: development, or
# a host whose disk survives deploys, which also needs AUDIO_LOCAL_IS_PERMANENT=true) or remote (an
# object-storage service; app/core/blobstore.py has the skeleton). If the choice is unusable the audio just
# stays in the database. Move what exists with scripts/move_audio.py (it checks every file by reading it back).
# AUDIO_STORAGE=db
# AUDIO_LOCAL_DIR=
# OBJECT_STORE_ENDPOINT=
# OBJECT_STORE_BUCKET=
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
# OBJECT_STORE_REGION=

# Local dev origins are fixed in app/core/config.py (http://localhost:3000 and :3001); the
# Vercel domain and its preview deployments are always allowed. ALLOW_ORIGINS can be set but
# must be a JSON array, e.g. ALLOW_ORIGINS=["http://localhost:3000"]
